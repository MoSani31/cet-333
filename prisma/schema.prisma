generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Inquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  companyName String
  country     String
  jobTitle    String
  jobDetails  String
  createdAt   DateTime @default(now())
}
