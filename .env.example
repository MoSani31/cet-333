# Neon (or any Postgres): pooled connection URL from the Neon dashboard.
# Replace USER, PASSWORD, host, and DB name with yours. sslmode=require is typical for Neon.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

SESSION_SECRET="change-me-to-a-random-string-at-least-32-chars-long"
ADMIN_PASSWORD="admin123"
